{
  "name": "markov-explorable",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive explorable explanation of Markov chains, powered by a C99 engine compiled to WebAssembly",
  "type": "module",
  "scripts": {
    "wasm": "cd .. && cmake --preset wasm && cmake --build --preset wasm",
    "corpora": "node scripts/copy-corpora.mjs",
    "dev": "npm run corpora && vite",
    "build": "npm run corpora && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "d3": "^7.9.0",
    "katex": "^0.19.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.19.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
